# Copy to .env and adjust. .env is git-ignored: never commit real keys.

# Risk LLM (default: local Ollama, prompts never leave the machine)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:3b

# ...or the OpenAI key provided for the hackathon (only redacted text is sent):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Optional: a real model behind the gateway, so allowed prompts get a real answer
# LANTERN_UPSTREAM=https://api.openai.com/v1/chat/completions
# LANTERN_UPSTREAM_KEY=sk-...

# Synthetic demo data on first start (0 = off)
# LANTERN_DEMO=1
